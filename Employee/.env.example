# Flask & Server Settings
FLASK_ENV=production
SECRET_KEY=your-custom-production-secret-key
PORT=5001

# Database Configuration (Option 1: Standard URL - Recommended for Render + Aiven)
# DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>?ssl_mode=REQUIRED

# Database Configuration (Option 2: Individual variables)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_local_password
DB_NAME=employee_management
DB_PORT=3306
DB_SSL=false

# SMTP Mail Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
